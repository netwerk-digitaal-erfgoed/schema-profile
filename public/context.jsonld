{
  "@context": {
    "@version": 1.1,
    "@import": "https://def.nde.nl/context.jsonld",
    "@vocab": "https://schema.org/",
    "schema": "https://schema.org/",

    "creator":         { "@container": "@set" },
    "material":        { "@container": "@set" },
    "additionalType":  { "@container": "@set" },
    "genre":           { "@container": "@set" },
    "about":           { "@container": "@set" },
    "identifier":      { "@container": "@set" },
    "contentLocation": { "@container": "@set" },
    "locationCreated": { "@container": "@set" },
    "hasOccupation":   { "@container": "@set" },
    "associatedMedia": { "@container": "@set" },
    "sameAs":          { "@container": "@set", "@type": "@id" },

    "isPartOf":     { "@type": "@id" },
    "thumbnailUrl": { "@type": "@id" },
    "url":          { "@type": "@id" }
  }
}
