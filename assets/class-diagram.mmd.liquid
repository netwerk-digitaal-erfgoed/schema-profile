---
title: SCHEMA-AP-NDE
---
classDiagram
direction TB

{%- assign mainNodeShapes = nodeShapes | where: "name" -%}
{% for nodeShape in mainNodeShapes %}
    class {{ nodeShape.name }} {
        {% if nodeShape.nodeKind == "IRI" -%}**URI**&nbsp;{%- endif -%}
    {%- assign merged_properties = nodeShape.property | mergePropertiesByPath -%}
    {%- for property in merged_properties -%}
        {%- assign name = property.path | replace: "schema:", "" %}

        {%- if property.or -%}
            {%- for or in property.or -%}
                {%- if or.node -%}
                    {{ or.node.name | default: or.node.class }}
                {%- elsif or.nodeKind -%}
                    {{ or.nodeKind }}
                {%- endif -%}
            {% endfor %}
        {%- endif %}
        **{{ name }}**: {% if property.datatype -%}
            {{ property.datatype }}
        {%- elsif property.nodeKind -%}
            {{- property.nodeKind -}}
        {%- elsif property.node.or -%}
            {{ property.node.or | first | map: "datatype" | join: " | " }}
        {%- elsif property.node -%}
            {{ property.node.name | default: property.node.class }}
        {%- endif %} [
        {%- comment -%} A merged row can take its sh:minCount from a Warning, which does not make the property required. {%- endcomment -%}
        {%- assign minCount = 0 -%}
        {%- for shape in nodeShape.property -%}
            {%- assign shape_severity = shape.severity | default: "Violation" -%}
            {%- if shape.path == property.path and shape.minCount > 0 and shape_severity == "Violation" -%}
                {%- assign minCount = shape.minCount -%}
                {%- break -%}
            {%- endif -%}
        {%- endfor -%}
        {%- assign maxCount = property.maxCount | default: "*" -%}
        {%- if minCount == maxCount -%}
             {{- minCount -}}
        {%- else -%}
            {{ minCount }}..{{ maxCount }}
        {%- endif -%}
        ]
    {%- endfor %}
    }
{% endfor %}

    CreativeWork --> DefinedTerm : additionalType<br>about<br>material<br>genre
    CreativeWork --> Place : contentLocation<br>locationCreated<br>
    CreativeWork --> "1..*" Organization : creator
    CreativeWork --> "1..*" Person : creator
    CreativeWork --> "1..*" MediaObject : associatedMedia

    Person --> "0..*" Occupation : hasOccupation

    Person --> "0..1" Place : birthPlace<br>deathPlace

    Place --> "0..1" GeoCoordinates : geo
    Place --> "0..*" PostalAddress : address

    Organization --> "0..1" Place : location

